# DeckHand environment variables.
# Copy this file to ".env" and fill in your own values, then restart `npm run dev`.

# --- Database (Supabase) — required for bookings to actually save ---
# Find these in your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Weather data source (optional) ---
# WillyWeather gives richer AU marine data (wind/swell). Needs a paid API key.
# Without it, the forecast falls back to the free Open-Meteo source automatically.
# WILLYWEATHER_API_KEY=your-willyweather-key

# --- Optional integrations (only needed when deployed) ---
# Stripe (real deposits) — server-side, used by api/deckhand/pay.js
# STRIPE_SECRET_KEY=sk_live_or_test_xxx
# SMS via Twilio — used by api/deckhand/notify.js
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_FROM=+61xxxxxxxxx
# Email via Postmark — used by api/deckhand/notify.js
# POSTMARK_TOKEN=xxxx
# POSTMARK_FROM=bookings@yourdomain.com
