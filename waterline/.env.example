# Copy to .env and fill in. Nothing here is required to run the demo — the
# frontend works standalone and the API serves seed/snapshot data without creds.

# --- Frontend ---
# Point the UI at a deployed API to use live backend data. Leave blank to run
# entirely client-side on the bundled snapshot.
VITE_API_BASE=

# --- Backend (server/) ---
PORT=8787
WATERLINE_DATA=seed            # "seed" (Harbor & Vine sample) | "shopify" (captured snapshot)

# --- Real integrations (later phases; connectors stay stubbed until set) ---
# Shopify — single store (custom-app admin token, fastest for your own store)
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# Shopify — multi-merchant OAuth app (Partner app). Enables /auth install flow.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,read_returns,read_discounts,read_reports
APP_URL=http://localhost:8787   # public URL of THIS API (OAuth redirect + webhook target)

# Database (Postgres / Supabase) — persistence; in-memory if unset
DATABASE_URL=

# Meta Marketing API (requires app review for ads_read)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads API (requires an approved developer token)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
