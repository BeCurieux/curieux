# Copy to .env and fill in. Never commit .env.

# --- Shopify ---------------------------------------------------------------
# `npm run dev` (Shopify CLI) injects these for you from the linked app.
# Set them yourself only when running the server outside the CLI.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products
# Optional: a custom shop domain for local testing.
# SHOP_CUSTOM_DOMAIN=

# --- Supabase Postgres -----------------------------------------------------
# Supabase dashboard → Connect.
# App queries go through the transaction pooler (port 6543). pgbouncer=true
# stops Prisma using prepared statements, which the pooler does not support.
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations need a session-level connection: the session pooler (port 5432).
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@[region].pooler.supabase.com:5432/postgres"

# Local Postgres alternative (e.g. `supabase start` or Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscribundle"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/subscribundle"
