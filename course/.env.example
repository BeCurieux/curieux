# Copy to .env.local. Never commit real keys; production values go in Vercel.

# --- Supabase ---------------------------------------------------------------
# Local: `npm run db:start` prints these (API URL, Publishable key, Secret key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row level security.
SUPABASE_SECRET_KEY=

# Where the app is served. Sign-in links fall back to this host.
APP_URL=http://localhost:3300

# --- Lesson videos (Bunny Stream) ---------------------------------------------
# Stream → your library → API: the Library ID. YouTube videos need nothing.
BUNNY_STREAM_LIBRARY_ID=
# Optional. Stream → library → Security → Embed view token authentication.
# When set, every video URL is signed and expires after six hours.
BUNNY_STREAM_TOKEN_KEY=

# --- Stripe -------------------------------------------------------------------
# Test mode until launch: Developers → API keys (sk_test_…). Then run
# `npm run stripe:setup` once to create the products and prices.
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint (…/api/webhooks/stripe) → Signing secret.
# Locally: `stripe listen --forward-to localhost:3300/api/webhooks/stripe` prints one.
STRIPE_WEBHOOK_SECRET=
# After 14 days the refund button becomes a mailto to this address.
SUPPORT_EMAIL=

# --- Email (Resend) -------------------------------------------------------------
# Without a key, outside production, emails are logged instead of sent and
# /check falls back to Supabase's own sign-in email.
RESEND_API_KEY=
# The sender, on a domain verified in Resend.
EMAIL_FROM=Her Little Empire <hello@example.com>
EMAIL_REPLY_TO=
# Signs unsubscribe links (any long random string). Defaults to SUPABASE_SECRET_KEY.
EMAIL_TOKEN_SECRET=
# Vercel cron sends this as a bearer token to /api/cron/email.
CRON_SECRET=
