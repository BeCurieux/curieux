# Copy to .env.local. Never commit real keys; production values go in Vercel.

# --- Supabase ---------------------------------------------------------------
# Local: `npm run db:start` prints these (API URL, Publishable key, Secret key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row level security.
SUPABASE_SECRET_KEY=

# Where the app is served. Sign-in links fall back to this host.
APP_URL=http://localhost:3300
