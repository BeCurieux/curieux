# Locally, run scripts/local-env.sh after `npm run db:start` instead of
# copying this file: it writes .env.local from the running stack.

# Public — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Sentry and PostHog stay off when these are empty.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog has no Australian region; leave empty (analytics off) unless
# overseas analytics is disclosed in the privacy policy.
NEXT_PUBLIC_POSTHOG_HOST=

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Seed script and tests only. Never set in a deployed environment.
SEED_PASSWORD=

# Email (M6c). Off unless set: "resend" for real email, "mailpit" locally.
EMAIL_TRANSPORT=
EMAIL_FROM=
RESEND_API_KEY=
MAILPIT_URL=
# Where links in emails point, e.g. https://app.ovyko.com.au
APP_URL=
# At least 32 characters; also stored in the database's Vault as
# ovyko_cron_secret, with ovyko_app_url, so its schedule can call the sender.
CRON_SECRET=

# Card payments (M7b). Off unless set. Test keys (sk_test_) until the pilot.
STRIPE_SECRET_KEY=
# From the webhook endpoints Stripe gives for /api/stripe/webhook: the one
# for connected accounts and the one for Ovyko's own account, comma-separated.
STRIPE_WEBHOOK_SECRET=
# Ovyko's plan: the A$399-a-month-per-location price in Ovyko's Stripe.
STRIPE_SCHOOL_PRICE_ID=
# Local and CI only: Stripe's test double. Never set when deployed.
STRIPE_API_URL=
