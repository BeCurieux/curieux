# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI — provider-agnostic. "mock" runs the deterministic dev provider.
AI_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Print — provider-agnostic. "mock" runs the sandbox dev provider.
PRINT_PROVIDER=mock         # mock | prodigi
PRODIGI_API_KEY=
PRODIGI_API_URL=https://api.sandbox.prodigi.com/v4.0
PRODIGI_BOOK_SKU=BOOK-A4-HARD-M

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BOOK_PRICE_DIGITAL_AUD=4900
BOOK_PRICE_PRINT_AUD=12900

# Background jobs — shared secret for the job-runner endpoint
JOBS_SECRET=

# PDF rendering
CHROMIUM_PATH=/opt/pw-browsers/chromium

# Paper stock — drives spine width on the cover.
# Calipers are PROVISIONAL until physical samples are measured (see
# src/lib/pdf/cover.ts). Do not place a live print order until measured.
PAPER_STOCK=mohawk_superfine_eggshell

# Demo mode — runs the whole interface against an in-memory Florence fixture
# with no Supabase at all. `npm run demo`, then open localhost:3000.
DEMO_MODE=0

# ------------------------------------------------------------------ email
# Default is "mock", which records messages instead of sending them — so
# nothing goes out by accident in development or in a test run.
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
EMAIL_FROM=hello@ordinarytuesday.com
# Set to 1 to print every message the mock "sends" to the console.
EMAIL_DEBUG=0

# --------------------------------------------------------- payment methods
# Comma-separated Stripe payment method types. Leave EMPTY to use whatever is
# enabled in the Stripe Dashboard, which is the safe default — naming a method
# the account has not enabled fails the checkout session outright.
#
# Australian instalments (enable in the Dashboard first):
#   STRIPE_PAYMENT_METHODS=card,afterpay_clearpay,zip
STRIPE_PAYMENT_METHODS=
