{
  "name": "franca",
  "private": true,
  "version": "0.1.0",
  "description": "The claim engine, and the card it renders \u2014 copy in, cited findings, an explainable score, and a shareable artefact out.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "scan": "tsx --env-file-if-exists=.env.local scripts/scan.ts",
    "card": "tsx --env-file-if-exists=.env.local scripts/card.ts",
    "killtest": "tsx --env-file-if-exists=.env.local scripts/killtest.ts",
    "calibrate": "tsx --env-file-if-exists=.env.local scripts/calibrate.ts",
    "rules": "tsx --env-file-if-exists=.env.local scripts/rules.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "check:storage": "tsx --env-file-if-exists=.env.local scripts/check-storage.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
