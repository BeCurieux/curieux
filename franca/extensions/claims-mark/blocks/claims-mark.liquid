{%- comment -%}
  The product's mark, fetched through the app proxy from the shop's own
  domain. The server decides everything: a product that has not earned the
  mark, has changed since it was read, or belongs to a shop that uninstalled
  comes back as an empty image, so nothing shows. Nothing here can make a mark
  appear that the scan did not produce.

  The path assumes the proxy's default prefix and subpath (apps/franca, from
  shopify.app.toml). A merchant can rename those in their admin; if they do,
  the mark stops showing rather than showing something wrong.
{%- endcomment -%}
{%- if product -%}
  <div class="franca-claims-mark" style="display:flex;justify-content:{{ block.settings.alignment }};margin:{{ block.settings.spacing }}px 0;">
    <img
      src="/apps/franca/badge?product={{ product.id }}&theme={{ block.settings.theme }}"
      alt="{{ 'claims_mark.alt' | t }}"
      loading="lazy"
      decoding="async"
      style="max-width:320px;width:100%;height:auto;"
    >
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.claims_mark.name",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "t:blocks.claims_mark.settings.theme.label",
      "info": "t:blocks.claims_mark.settings.theme.info",
      "options": [
        { "value": "paper", "label": "t:blocks.claims_mark.settings.theme.paper" },
        { "value": "night", "label": "t:blocks.claims_mark.settings.theme.night" }
      ],
      "default": "paper"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.claims_mark.settings.alignment.label",
      "options": [
        { "value": "flex-start", "label": "t:blocks.claims_mark.settings.alignment.left" },
        { "value": "center", "label": "t:blocks.claims_mark.settings.alignment.center" },
        { "value": "flex-end", "label": "t:blocks.claims_mark.settings.alignment.right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "t:blocks.claims_mark.settings.spacing.label",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ]
}
{% endschema %}
