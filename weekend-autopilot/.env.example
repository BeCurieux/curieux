# ---------------------------------------------------------------- brand
# "52 Weekends" is a WORKING NAME (see src/config/brand.ts). Everything
# customer-facing reads from these, so a rename is a config change.
NEXT_PUBLIC_PRODUCT_NAME="52 Weekends"
NEXT_PUBLIC_PRODUCT_TAGLINE="You get 52 weekends a year. We'll make them count."
NEXT_PUBLIC_PRODUCT_DOMAIN="52weekends.com"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@52weekends.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses RLS. Jobs, webhooks and admin only — never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs, not amounts: the displayed price is read from Stripe.
STRIPE_PRICE_PILOT=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=

# ---------------------------------------------------------------- AI
# "mock" is a deterministic rule-based provider used in dev and CI.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ---------------------------------------------------------------- providers
# "mock" runs against the Sydney fixtures in src/lib/providers/places/fixtures.
PLACES_PROVIDER=mock
PLACES_API_KEY=
ROUTES_PROVIDER=mock
ROUTES_API_KEY=
# open-meteo needs no key; "mock" gives deterministic weather for tests.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# ---------------------------------------------------------------- email
NOTIFICATIONS_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM="52 Weekends <hello@52weekends.com>"

# ---------------------------------------------------------------- analytics
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------- operations
# Required. Cron endpoints refuse to run without it rather than running open.
CRON_SECRET=

# ---------------------------------------------------------------- flags
# The founder-review switch (§42). True for the first cohort; the goal is false.
REQUIRE_PLAN_REVIEW=true

FLAG_OFFER_PILOT=true
FLAG_OFFER_ANNUAL=false
FLAG_OFFER_MONTHLY=false
FLAG_FEEDBACK_EMAILS=true
FLAG_PLAN_SWAPS=true
FLAG_OVERNIGHT_ESCAPES=false
FLAG_AFFILIATE_LINKS=false

# ---------------------------------------------------------------- market
SUPPORTED_MARKET=sydney
