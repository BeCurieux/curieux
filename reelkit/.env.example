# All optional locally. See README.md, "Configuration".

# Claude drafts the ad copy when this is set; without it the ads come from templates.
ANTHROPIC_API_KEY=

# Etsy Open API v3, as "keystring:shared_secret". Without it, most Etsy links fall back to manual entry.
ETSY_API_KEY=

# Required in production: any long random string (e.g. `openssl rand -hex 32`).
IMAGE_PROXY_SECRET=
