# All optional locally. See README.md, "Configuration" and "Setting up accounts and payments".

# Claude drafts the ad copy when this is set; without it the ads come from templates.
ANTHROPIC_API_KEY=

# Etsy Open API v3, as "keystring:shared_secret". Without it, most Etsy links fall back to manual entry.
ETSY_API_KEY=

# Required in production: any long random string (e.g. `openssl rand -hex 32`).
IMAGE_PROXY_SECRET=

# Accounts and credits. All three, or none.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Credit purchases. Both, or neither. Needs accounts on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The site's public address, for Stripe's return links and the sign-in email link.
APP_URL=

# Only for running tests/db.test.ts locally against a Postgres server.
REELKIT_TEST_DATABASE_URL=
