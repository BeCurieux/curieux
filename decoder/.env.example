# The only secret this project has, and only `pnpm decode` needs it.
#
# `pnpm verdict`, `pnpm press`, `pnpm knowledge` and the whole test suite run
# without it: everything downstream of `ParsedLabel` is ordinary code, and the
# tests inject their own transport. That is a property of the architecture
# rather than a convenience — CI never reaches a model, so a red run is always
# about the commit.
ANTHROPIC_API_KEY=
