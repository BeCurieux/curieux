{
  "name": "shopfront",
  "private": true,
  "version": "0.1.0",
  "description": "Shopfront — make a shop in a sentence. Sprint 1, step 1: the ingester.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "genome": "tsx --env-file-if-exists=.env.local scripts/genome.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "merchandise": "tsx --env-file-if-exists=.env.local scripts/merchandise.ts",
    "generate": "tsx --env-file-if-exists=.env.local scripts/generate.ts",
    "refresh": "tsx --env-file-if-exists=.env.local scripts/refresh.ts",
    "funnel": "tsx --env-file-if-exists=.env.local scripts/funnel.ts",
    "killtest": "tsx --env-file-if-exists=.env.local scripts/killtest.ts",
    "screen": "tsx --env-file-if-exists=.env.local scripts/screen.ts",
    "rls:check": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f src/lib/publish/rls-check.sql",
    "browser:check": "tsx --env-file-if-exists=.env.local scripts/browser-check.ts",
    "press": "node scripts/press/logo.mjs && node scripts/press/shops.mjs && node scripts/press/capture.mjs && node scripts/press/compose.mjs && node scripts/press/motion.mjs",
    "deploy:check": "tsx --env-file-if-exists=.env.local scripts/deploy-check.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "supabase:setup": "tsx --env-file-if-exists=.env.local scripts/supabase-setup.ts",
    "press:edits": "tsx --env-file-if-exists=.env.local scripts/press/edits.ts",
    "press:capture-edits": "node scripts/press/capture-edits.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.0",
    "playwright-core": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "1.62.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
