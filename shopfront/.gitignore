node_modules/
.next/
.env
.env.local
.env*.local
*.tsbuildinfo

# Ingested catalogues, cached so that iterating on the merchandiser does not
# mean re-fetching somebody else's storefront a hundred times. Real data about
# real shops — it does not belong in the repository.
.cache/
next-env.d.ts
.env.local

# The real kill-test target list — businesses that have agreed to nothing.
#
# `targets.txt` and the run ledger stay out: those accumulate what real people
# said when they were asked, which is theirs and not ours to commit.
#
# The *candidate* lists are committed, deliberately. They are unverified public
# storefront URLs — closer to a bookmark file than a contact list, and nobody on
# them has been approached. Ignoring them cost more than it protected: the
# screener runs on a machine with network access, this one has none, and every
# batch had to be hand-carried to that machine as an attachment. That failed
# twice, the second time as an ENOENT halfway through a run.
killtest-targets.txt
killtest/*
!killtest/targets.example.txt
!killtest/candidates.txt
!killtest/candidates-makers.txt
