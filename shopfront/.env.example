# popuup — environment
#
# Copy to .env.local for development. Everything here is optional: with none of
# it set the pipeline runs on the deterministic providers and the filesystem
# store, which is what makes `pnpm generate` work on a laptop with no accounts.

# ---------------------------------------------------------------- generation

# `anthropic` uses the model for both the Genome and the merchandiser.
# Anything else (or unset) uses the deterministic providers.
AI_PROVIDER=mock

ANTHROPIC_API_KEY=

# Merchandising is the product, so it gets the larger model by default.
# AI_MODEL=claude-opus-5
# AI_EFFORT=high

# The Genome is a structured read over up to 160 products, once per store.
# GENOME_MODEL=claude-sonnet-5
# GENOME_EFFORT=medium

# ---------------------------------------------------------------- persistence

# Both must be set for the Supabase store; with either missing, shops are
# written to .cache/published/ instead. Whichever ran is named in the CLI
# output, so it is never a mystery which one you got.
#
# Apply src/lib/publish/schema.sql to the project first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The service role key is a server-only secret. It bypasses row-level security
# and must never be given a NEXT_PUBLIC_ prefix or reach a browser bundle.

# ---------------------------------------------------------------------- URLs

# What `pnpm generate` prints in front of a slug. Unset gives a relative path.
PUBLIC_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------ scraping

# The Playwright fallback, for storefronts /products.json cannot cover.
# CHROMIUM_PATH=/opt/pw-browsers/chromium/chrome
