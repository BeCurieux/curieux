# ------------------------------------------------------------------ ingester
# Nothing in the ingester requires a key: it reads public storefront surfaces
# only. These tune how it behaves against somebody else's server.

# Sent on every request. Keep it identifiable and keep the URL reachable —
# we are fetching from stores that have not asked us to, so a merchant who
# looks at their logs deserves to be able to find out who we are.
INGEST_USER_AGENT=

# Playwright is the last rung of the ladder, for storefronts that render
# their catalogue in the browser. Left unset, the renderer is skipped and the
# ingest reports why rather than failing silently.
CHROMIUM_PATH=/opt/pw-browsers/chromium

# ---------------------------------------------------------------- later steps
# Step 2 (merchandiser) is the first thing here that costs money.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Steps 4-5. Unused until there is something to publish.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
