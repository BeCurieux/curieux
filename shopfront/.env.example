# ------------------------------------------------------------------ ingester
# Nothing in the ingester requires a key: it reads public storefront surfaces
# only. These tune how it behaves against somebody else's server.

# Sent on every request. Keep it identifiable and keep the URL reachable —
# we are fetching from stores that have not asked us to, so a merchant who
# looks at their logs deserves to be able to find out who we are.
INGEST_USER_AGENT=

# Playwright is the last rung of the ladder, for storefronts that render
# their catalogue in the browser. Left unset, the renderer is skipped and the
# ingest reports why rather than failing silently.
CHROMIUM_PATH=/opt/pw-browsers/chromium

# ------------------------------------------------------------- merchandiser
# Step 2, and the first thing here that costs money.
#
# "mock" is the deterministic merchandiser: no key, no network, no cost. It
# assembles a defensible default shop from the ingest alone, which is what the
# tests run against and what the renderer can develop against — and it is the
# baseline the model has to beat to be worth its price.
AI_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=

# Merchandising IS the product — the thing the brief says replaces page
# building — so this is the one place not to economise by default. Measure
# before moving it.
AI_MODEL=claude-opus-5

# How hard the model thinks. "high" is the API default and the quality
# setting; "medium" is the lever if the sixty-second bar starts to bite.
AI_EFFORT=high              # low | medium | high | xhigh | max

# Steps 4-5. Unused until there is something to publish.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
