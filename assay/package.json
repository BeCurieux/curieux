{
  "name": "assay",
  "private": true,
  "version": "0.1.0",
  "description": "The claim engine — marketing copy in, guidance-framed findings and a Claim Confidence Score out.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "scan": "tsx --env-file-if-exists=.env.local scripts/scan.ts",
    "rules": "tsx --env-file-if-exists=.env.local scripts/rules.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.23.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
