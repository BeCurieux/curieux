# Copy to .env.local and fill in. The guardrail + cadence test suites run with
# NONE of these set (they use in-memory fakes and a stub classifier). Everything
# below is for running the real app against a real store.

# --- Shopify (embedded admin app + theme extension) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_inventory
# Public https URL of THIS app (OAuth redirect + webhook + app-proxy target).
APP_URL=https://haunted.example.com
NEXT_PUBLIC_SHOPIFY_API_KEY=            # must equal SHOPIFY_API_KEY (App Bridge, client)

# --- Supabase (Postgres + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # server-only; bypasses RLS for the send job
# 32-byte base64 key used to encrypt shops.access_token at rest.
TOKEN_ENCRYPTION_KEY=

# --- Anthropic (voice generation + safety classifier) ---
ANTHROPIC_API_KEY=
# claude-haiku-4-5 — cheap/fast/high-volume, per the brief. Override to pin a date.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Web Push (VAPID) — run `npm run keys:vapid` to generate a pair ---
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:hello@example.com
NEXT_PUBLIC_VAPID_PUBLIC=               # must equal VAPID_PUBLIC (client subscribes with it)

# --- Stripe (usage-tiered billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Feature flags ---
FEATURE_GRAVEYARD=false                 # keep OFF for v1 (CLAUDE.md §Graveyard)

# --- Cron auth ---
# Shared secret the trigger cron sends as `Authorization: Bearer` to /api/cron/*.
CRON_SECRET=
