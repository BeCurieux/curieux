# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI — provider-agnostic. "mock" runs the deterministic dev provider.
AI_PROVIDER=mock            # mock | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Print — provider-agnostic. "mock" runs the sandbox dev provider.
PRINT_PROVIDER=mock         # mock | prodigi
PRODIGI_API_KEY=
PRODIGI_API_URL=https://api.sandbox.prodigi.com/v4.0
PRODIGI_BOOK_SKU=BOOK-A4-HARD-M

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BOOK_PRICE_DIGITAL_AUD=4900
BOOK_PRICE_PRINT_AUD=12900

# Background jobs — shared secret for the job-runner endpoint
JOBS_SECRET=

# PDF rendering
CHROMIUM_PATH=/opt/pw-browsers/chromium
