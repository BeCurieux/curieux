# MarketFit — environment. Copy to .env.local for `pnpm dev`.

# The app's client ID and secret, from the Partner Dashboard. Required.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# The previous secret during a rotation; both verify for the overlap.
# SHOPIFY_API_SECRET_PREVIOUS=

# Storage. All three, or none (memory — refused when NODE_ENV=production).
# Apply supabase/migrations/*.sql and then supabase/seed.sql to the project.
# The secret key bypasses RLS: server only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 32 bytes, base64: `openssl rand -base64 32`. Seals Shopify tokens before they
# reach the database. Losing it means every merchant reinstalls.
MARKETFIT_TOKEN_KEY=
# MARKETFIT_TOKEN_KEY_PREVIOUS=
