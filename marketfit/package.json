{
  "name": "marketfit",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-border readiness for Shopify supplement merchants: per SKU, per market, what is missing and the rule that says so.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "rules": "tsx scripts/rules.ts",
    "rules:sql": "tsx scripts/rules.ts --sql supabase/seed.sql",
    "db:check": "bash scripts/db-check.sh"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
