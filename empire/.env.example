# Empire Studio environment. Copy to .env.local for development.
# Every variable is explained in docs/ENVIRONMENT.md.

# --- Backend ------------------------------------------------------------
# local: JSON file + email-only sign-in (dev/test/demo; refused on Vercel production)
# supabase: Postgres + RLS + magic-link sign-in
EMPIRE_BACKEND=local
EMPIRE_DATA_DIR=.data/local
# 32+ characters. Signs the local session cookie and the checkout reference.
EMPIRE_SESSION_SECRET=

# --- Supabase (EMPIRE_BACKEND=supabase) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000

# --- AI -----------------------------------------------------------------
# mock: free offline generator. anthropic: Claude.
EMPIRE_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
EMPIRE_AI_MODEL=claude-opus-5-5
EMPIRE_AI_EFFORT=low
EMPIRE_AI_TIMEOUT_MS=120000
EMPIRE_AI_DAILY_BUDGET_USD=25

# --- Payments (Gumroad) ---------------------------------------------------
GUMROAD_PRODUCT_ID=
GUMROAD_PRODUCT_URL=
GUMROAD_PING_SECRET=
GUMROAD_ACCESS_TOKEN=
CRON_SECRET=
# Whole US dollars, no "$" (a "$" in .env files is read as a variable).
NEXT_PUBLIC_LAUNCH_PACK_PRICE_USD=49
# Email opt-in on /fit-check: off until a sender for the welcome emails exists.
EMPIRE_EMAIL_OPTIN=off
NEXT_PUBLIC_INCOME_FIT_TEST_URL=https://herlittleempireco.gumroad.com/l/income-fit-test

# --- Founder -------------------------------------------------------------
ADMIN_EMAILS=
