# Lattice — environment variables (copy to .env)

# --- Frontend ---
# Point the UI at the live backend instead of local sample data.
# Unset → the app runs entirely client-side on src/lib/data.js.
# VITE_API_BASE=http://localhost:8788

# --- Backend ---
# Port for the Express API (server/server.js). Defaults to 8788.
# PORT=8788

# --- Shopify (next phase) ---
# Admin API credentials for real ingestion (products, variants, inventory
# levels, selling plans). Not used by the skeleton yet.
# SHOPIFY_SHOP=northbound-supply.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
